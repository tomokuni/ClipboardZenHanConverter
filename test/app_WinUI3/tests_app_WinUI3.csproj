<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <UseWinUI>true</UseWinUI>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <RootNamespace>EsUtil.ClipboardZenHanConverter.Tests.App.WinUI</RootNamespace>
    <AssemblyName>ClipboardZenHanConverter.Tests.App.WinUI</AssemblyName>
    <!-- Windows App SDK のビルド要件（リポジトリ共通の Directory.Build.props には置かない） -->
    <Platforms>x64</Platforms>
    <SelfContained>true</SelfContained>
    <!--
      Windows App SDK も自己完結にする（実行環境に Windows App Runtime が不要になる）。
      未設定の場合は Microsoft.WindowsAppRuntime.Bootstrap.dll が同梱され、起動時に
      インストール済みのランタイムを探しに行く。見つからない環境（CI など）では
      導入を促すダイアログを出して待ち続けるため、テストが無言で停止する。
    -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.analyzers" Version="2.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="4.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\core\core.csproj" />
    <ProjectReference Include="..\..\src\app_WinUI3\app_WinUI3.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- テスト共通ヘルパーは test 直下に単一所有し、各テストプロジェクトへリンクして共有する -->
    <Compile Include="..\TestHelper.cs" Link="TestHelper.cs" />
  </ItemGroup>

</Project>
