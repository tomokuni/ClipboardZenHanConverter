<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <UseWinUI>true</UseWinUI>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <RootNamespace>EsUtil.ClipboardZenHanConverter.Tests.App.WinUI</RootNamespace>
    <AssemblyName>ClipboardZenHanConverter.Tests.App.WinUI</AssemblyName>
    <!-- Windows App SDK のビルド要件（リポジトリ共通の Directory.Build.props には置かない） -->
    <Platforms>x64</Platforms>
    <SelfContained>true</SelfContained>
    <!--
      Windows App SDK の自動初期化を無効にする。
      有効（既定）の場合はアセンブリにモジュール初期化子が埋め込まれ、起動時に
      ブートストラップ（OnNoMatch_ShowUI）が Windows App Runtime を探す。
      インストールされていない環境（CI など）では導入ダイアログを出して待ち続けるため、
      テストが結果を出さないまま停止する。テストは WinRT を使わないため初期化は不要。
    -->
    <WindowsAppSdkAutoInitialize>false</WindowsAppSdkAutoInitialize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.analyzers" Version="2.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="4.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\core\core.csproj" />
    <ProjectReference Include="..\..\src\app_WinUI3\app_WinUI3.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- テスト共通ヘルパーは test 直下に単一所有し、各テストプロジェクトへリンクして共有する -->
    <Compile Include="..\TestHelper.cs" Link="TestHelper.cs" />
  </ItemGroup>

</Project>
