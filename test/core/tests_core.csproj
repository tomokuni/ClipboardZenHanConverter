<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>EsUtil.ClipboardZenHanConverter.Tests.Core</RootNamespace>
    <AssemblyName>ClipboardZenHanConverter.Tests.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.analyzers" Version="2.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="4.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Core のみを参照し、UI フレームワークに依存しないことを保証する -->
    <ProjectReference Include="..\..\src\core\core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- テスト共通ヘルパーは test 直下に単一所有し、各テストプロジェクトへリンクして共有する -->
    <Compile Include="..\TestHelper.cs" Link="TestHelper.cs" />
  </ItemGroup>

</Project>
