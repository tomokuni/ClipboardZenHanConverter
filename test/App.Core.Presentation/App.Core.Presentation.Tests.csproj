<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>EsUtil.ZenHanConverter.Tests.App.Core.Presentation</RootNamespace>
    <AssemblyName>ZenHanConverter.Tests.App.Core.Presentation</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\App.Core.Presentation\App.Core.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- テスト共通ヘルパーは test 直下に単一所有し、各テストプロジェクトへリンクして共有する -->
    <Compile Include="..\TestHelper.cs" Link="TestHelper.cs" />
  </ItemGroup>

</Project>
