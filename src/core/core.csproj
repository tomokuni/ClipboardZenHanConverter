<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EsUtil.ClipboardZenHanConverter.Core</RootNamespace>
    <AssemblyName>ClipboardZenHanConverter.Core</AssemblyName>
    <Description>Core logic, models and platform APIs for ClipboardZenHanConverter (UI framework agnostic)</Description>
    <Copyright>Copyright (c) 2025</Copyright>
    <!-- Win32 P/Invoke（LibraryImport ソース生成）が unsafe コードを生成するため許可する -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.*" />
    <PackageReference Include="EsUtil.Text.ZenHanConverter" Version="1.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- アイコン形状は SVG ファイルを唯一の定義元とし、UI フレームワーク非依存のパスデータとして提供する -->
    <EmbeddedResource Include="Icons\**\*.svg" />
  </ItemGroup>

</Project>
