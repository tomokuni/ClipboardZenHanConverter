<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- コンパイル時バインディングを既定にし、実行時リフレクション（AOT 非互換）を排除する -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!--
      Views は DI コンテナが ViewModel を注入して生成するため、既定コンストラクタを持ちません。
      実行時 XAML ローダー（avares スキームでの読み込み）は使用しないため、その警告のみ抑止します。
    -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <RootNamespace>EsUtil.ZenHanConverter.App.AvaloniaUI</RootNamespace>
    <AssemblyName>ZenHanConverter.App.AvaloniaUI</AssemblyName>
    <Product>ZenHanConverter</Product>
    <Description>ZenHanConverter (Avalonia UI) - clipboard text converter</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\core\core.csproj" />
    <ProjectReference Include="..\core_presentation\core_presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 検証ロジック（internal static）をテストから参照するため -->
    <InternalsVisibleTo Include="ZenHanConverter.Tests.App.AvaloniaUI" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <!-- 開発者ツールは Avalonia.Diagnostics（廃止）ではなく AvaloniaUI.DiagnosticsSupport を使用する。Release へは含めない -->
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

</Project>
