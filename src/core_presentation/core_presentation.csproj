<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EsUtil.ZenHanConverter.Presentation</RootNamespace>
    <AssemblyName>ZenHanConverter.Presentation</AssemblyName>
    <Description>UI framework agnostic presentation layer (ViewModels) for ZenHanConverter</Description>
    <Copyright>Copyright (c) 2025</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- 依存方向: App（4 つの UI） → Presentation（本プロジェクト） → Core -->
    <ProjectReference Include="..\core\core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <!-- 検証ロジック（internal static）をテストから参照するため -->
    <InternalsVisibleTo Include="ZenHanConverter.Tests.Presentation" />
  </ItemGroup>

</Project>
