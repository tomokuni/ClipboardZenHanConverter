<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClipboardZenHanConverter.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ClipboardZenHanConverter.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:m="using:ClipboardZenHanConverter.Core.Models"
    mc:Ignorable="d">

    <ScrollView>
        <StackPanel>
            <StackPanel Margin="40,20,40,40">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                        <ToggleSwitch OnContent="全角/半角の変換" OffContent="全角/半角の変換"
                            IsOn="{x:Bind ViewModel.Config.IsEnabledZenHan, Mode=TwoWay}"/>
                        <TextBlock
                            Text="各文字ごとに全角⇔半角の変換 や 正規化 を行います。"
                            FontSize="12"
                            Foreground="Gray"
                            Margin="16,0,0,10"
                            VerticalAlignment="Bottom"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="設定画面へ移動します"
                        Command="{x:Bind ViewModel.NavigateToSettingsCommand}"
                        Style="{StaticResource SubtleButtonStyle}">
                        <SymbolIcon Symbol="Setting"/>
                    </Button>
                </Grid>
            </StackPanel>

            <StackPanel Margin="40,10,40,10">
                <TextBlock Text="変更前：" FontWeight="Bold"/>
                <Border BorderThickness="1" Background="#F0F0F0">
                    <TextBox
                        Text="{x:Bind ViewModel.BeforeText, Mode=TwoWay}"
                        PlaceholderText="クリップボードの変換前の内容を表示します。"
                        IsReadOnly="True"
                        TextWrapping="Wrap"
                        Foreground="Black"
                        Height="auto" MinHeight="50" MaxHeight="200"/>
                </Border>
            </StackPanel>
            <StackPanel Margin="40,10,40,10">
                <TextBlock Text="変更後：" FontWeight="Bold"/>
                <Border BorderThickness="1" Background="#F0F0F0">
                    <TextBox
                        Text="{x:Bind ViewModel.ConvertedText, Mode=TwoWay}"
                        PlaceholderText="クリップボードのテキストを変換した結果を表示します。"
                        IsReadOnly="True"
                        TextWrapping="Wrap"
                        Foreground="Black"
                        Height="auto" MinHeight="50" MaxHeight="200"/>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollView>
</Page>
