<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EsUtil.ClipboardZenHanConverter.App.WinUI.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EsUtil.ClipboardZenHanConverter.App.WinUI.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="ClipboardZenHanConverter">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <!-- Title Bar -->
            <RowDefinition Height="auto" />
            <!-- App Content -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <TitleBar Grid.Row="0"
                x:Name="titleBar"
                Title="clipboard text converter"
                IsBackButtonVisible="False"
                IsPaneToggleButtonVisible="True"
                PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.Content>
                <!--
                    タイトルバーの操作系コントロール（MewUI 版と同じ並び: スイッチ → プリセット選択）。
                    クリップボード変換スイッチは AppSetting.IsClipboardConvertEnabled を単一所有し、
                    プリセット選択は SettingsViewModel.SelectedPresetName を単一所有元として設定画面と同期する。
                    プリセット選択は幅を指定せず、項目の文字幅に合わせて自動でサイズを決めさせる。
                -->
                <Grid ColumnSpacing="24" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="0">
                        <!-- 既定スタイルはトラックの右側にも余白を持つため、余白を 0 にしてラベルを詰めて並べる -->
                        <ToggleSwitch x:Name="ClipboardConvertToggle"
                                      MinWidth="0"
                                      Padding="0"
                                      VerticalAlignment="Center"
                                      OnContent=""
                                      OffContent=""
                                      IsOn="{x:Bind AppSetting.IsClipboardConvertEnabled, Mode=TwoWay}"/>
                        <TextBlock Text="クリップボード変換" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ComboBox x:Name="PresetComboBox"
                              Grid.Column="1"
                              PlaceholderText="プリセット未選択"
                              VerticalAlignment="Center"
                              ToolTipService.ToolTip="保存済みのプリセットを選択して設定を読み込みます"/>
                </Grid>
            </TitleBar.Content>
        </TitleBar>

        <!-- App content -->
        <NavigationView Grid.Row="1"
                    x:Name="navigationView"
                    AlwaysShowHeader="True"
                    PaneDisplayMode="LeftCompact"
                    OpenPaneLength="104"
                    IsBackButtonVisible="Collapsed"
                    IsPaneToggleButtonVisible="False"
                    IsPaneOpen="False"
                    IsSettingsVisible="True"
                    SelectedItem="{x:Bind ViewModel.SelectedPage, Mode=TwoWay}">
            <NavigationView.MenuItems>
                <!-- 
				    NavigationService.Initialize() で IsSelected="True" の要素を初期選択状態にする
				    IsSelected="True" がなければ、設定ページを初期選択状態にする
				-->
                <!-- アイコンは FluentIcons（Core の SVG パスデータ）をコードから設定し、MewUI 版と形状を揃える -->
                <NavigationViewItem x:Name="HomeNavItem" Content="ホーム" Tag="Home" IsSelected="True"/>
            </NavigationView.MenuItems>
            <Grid x:Name="contentFrame"/>
        </NavigationView>
    </Grid>
</Window>
