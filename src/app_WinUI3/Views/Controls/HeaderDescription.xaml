<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ClipboardZenHanConverter.App.WinUI.Views.Controls.HeaderDescription"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ClipboardZenHanConverter.App.WinUI.Views.Controls">

    <UserControl.Resources>

        <!-- UserControl 内部のデフォルト Style -->
        <Style x:Key="DefaultHeaderStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>

        <Style x:Key="DefaultDescriptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="16,0,0,8"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>

    </UserControl.Resources>

    
    <StackPanel Orientation="Horizontal">
        <TextBlock x:Name="HeaderText" Text="{x:Bind Header, Mode=OneWay}"/>
        <TextBlock x:Name="DescriptionText" Text="{x:Bind Description, Mode=OneWay}"/>
    </StackPanel>
</UserControl>
