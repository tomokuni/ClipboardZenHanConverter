{
  "product": "ZenHanConverter",
  "versionFile": "Directory.Build.props",
  "solutionFile": "ZenHanConverter.slnx",
  "gateWorkflow": "build.yml",
  "releaseBranches": [
    "main",
    "release/**"
  ],
  "artifactRetentionDays": 30,
  "releaseNotes": "4 種の UI 実装の配布物です。いずれも zip で、展開すると exe（Avalonia UI 版はネイティブ DLL も）が入っています。",
  "uis": [
    {
      "name": "MewUI",
      "script": "buildScript/MewUI_publish_singleaot.bat",
      "output": "publish/mewui-win-x64-singleaot/ZenHanConverter.App.MewUI.exe",
      "asset": "ZenHanConverter.App.MewUI.zip",
      "zip": true
    },
    {
      "name": "WinUI3",
      "script": "buildScript/WinUI3_publish_single.bat",
      "output": "publish/winui3-win-x64-single/ZenHanConverter.App.WinUI3.exe",
      "asset": "ZenHanConverter.App.WinUI3.zip",
      "zip": true
    },
    {
      "name": "WinForms",
      "script": "buildScript/WinForms_publish_single.bat",
      "output": "publish/winforms-win-x64-single/ZenHanConverter.App.WinForms.exe",
      "asset": "ZenHanConverter.App.WinForms.zip",
      "zip": true
    },
    {
      "name": "AvaloniaUI",
      "script": "buildScript/AvaloniaUI_publish_aot.bat",
      "output": "publish/avaloniaui-win-x64-aot",
      "asset": "ZenHanConverter.App.AvaloniaUI.zip",
      "zip": true
    }
  ]
}
