<Project>

  <PropertyGroup>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <!-- 各ソースファイルが使用する名前空間を using のみで把握できるよう、暗黙の global using を無効化する -->
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <!-- リリースバージョン。全プロジェクトで単一所有し、各 .csproj では指定しない。 -->
    <!-- 自動インクリメントは行わない。リリース時に .github/workflows/release.yml が入力値へ更新する。 -->
    <Version>0.1.6</Version>
  </PropertyGroup>

</Project>
