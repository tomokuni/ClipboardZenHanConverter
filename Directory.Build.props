<Project>

  <PropertyGroup>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <!-- 各ソースファイルが使用する名前空間を using のみで把握できるよう、暗黙の global using を無効化する -->
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <!-- リリースバージョン。全プロジェクトで単一所有し、各 .csproj では指定しない。 -->
    <!-- 自動インクリメントは行わない。リリース時に .github/workflows/release.yml が入力値へ更新する。 -->
    <Version>0.1.7</Version>
  </PropertyGroup>

  <PropertyGroup Condition="Exists('$(MSBuildThisFileDirectory)..\EsUtil\.nupkg')">
    <!-- EsUtil の UI コントロールは、配置の計算などを EsUtil のローカル フィード（`.nupkg/`）の
         パッケージ参照で解決する。 隣のリポジトリが無い環境（GitHub 上のビルド）では
         この指定が付かず、EsUtil を参照するプロジェクトも存在しないため影響しない。 -->
    <RestoreAdditionalProjectSources>$(RestoreAdditionalProjectSources);$(MSBuildThisFileDirectory)..\EsUtil\.nupkg</RestoreAdditionalProjectSources>
  </PropertyGroup>

</Project>
