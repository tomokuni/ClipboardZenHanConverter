<Project>

  <PropertyGroup>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <!-- 各ソースファイルが使用する名前空間を using のみで把握できるよう、暗黙の global using を無効化する -->
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <!-- リリースバージョン。全プロジェクトで単一所有し、各 .csproj では指定しない。 -->
    <!-- main ブランチへの push で .github/workflows/release.yml が .github/scripts/bump-version.ps1 によりインクリメントする -->
    <Version>0.1.0</Version>
  </PropertyGroup>

</Project>
